<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.zerock.mapper.BoardMapper">

        <insert id="insert">
                /* 게시물 등록 */
                <selectKey
                        order="AFTER"
                        keyProperty="bno"
                        resultType="long">
                        SELECT LAST_INSERT_ID()
                </selectKey>
                INSERT INTO
                tbl_board
                (
                title,
                content,
                writer
                )
                VALUES
                (
                #{title},
                #{content},
                #{writer}
                )
        </insert>

        <select
                id="selectOne"
                resultType="boardDTO">
                /* 게시물 조회 */
                SELECT
                *
                FROM
                tbl_board
                WHERE
                1 = 1
                AND bno = #{bno}
        </select>

        <update id="remove">
                /* 게시물 삭제 */
                UPDATE
                tbl_board
                SET
                delflag = true
                WHERE
                1 = 1
                AND bno = #{bno}
        </update>

        <update id="update">
                /* 게시물 수정 */
                UPDATE
                tbl_board
                SET
                title = #{title},
                content = #{content},
                updatedate = NOW(),
                delflag = #{delFlag}
                WHERE
                1 = 1
                AND bno
                = #{bno}
        </update>

        <select
                id="list"
                resultType="BoardDTO">
                /* 게시물 목록 조회 */
                SELECT
                bno,
                title,
                writer,
                regdate
                FROM
                tbl_board
                WHERE
                1 = 1
                AND delflag = FALSE
                AND bno = 1
                ORDER BY bno DESC;
        </select>

        <select
                id="list2"
                resultType="BoardDTO">
                /* 게시물 목록 조회 2 */
                SELECT
                bno,
                title,
                writer,
                regdate
                FROM
                tbl_board
                WHERE
                1 = 1
                AND bno = 1
                AND delflag = FALSE
                ORDER BY
                bno DESC
                LIMIT #{count}
                OFFSET #{skip}
        </select>

        <select
                id="listCount"
                resultType="int">
                /* 전체 Board 개수 조회 */
                SELECT
                COUNT(bno)
                FROM
                tbl_board
                WHERE
                1 = 1
                AND delflag = FALSE
        </select>

        <!-- 동적 쿼리 분리 -->
        <sql id="search">
                <if test="types != null and keyword != null">
                        <foreach
                                collection="types"
                                item="type"
                                open=" AND ( "
                                close=" ) "
                                separator=" OR ">
                                <if test='type.equals("T")'>
                                        title LIKE CONCAT('%', #{keyword}, '%')
                                </if>
                                <if test='type.equals("C")'>
                                        content LIKE CONCAT('%', #{keyword}, '%')
                                </if>
                                <if test='type.equals("W")'>
                                        writer LIKE CONCAT('%', #{keyword}, '%')
                                </if>
                        </foreach>
                </if>
        </sql>

        <select
                id="listSearch"
                resultType="BoardDTO">
                /* 검색어로 게시물 조회 */
                SELECT
                board.bno,
                board.title,
                board.content,
                board.writer,
                board.regdate,
                board.updatedate,
                COUNT(reply.rno) AS replyCnt
                FROM
                tbl_board AS board
                LEFT OUTER JOIN tbl_reply AS reply
                ON board.bno = reply.bno
                WHERE
                1 = 1
                AND board.delflag = FALSE
                <include refid="search" />
                GROUP BY board.bno
                ORDER BY board.bno DESC
                LIMIT #{count}
                OFFSET #{skip}
        </select>

        <select
                id="listCountSearch"
                resultType="int">
                /* 검색어로 조회된 게시물의 개수 */
                SELECT count(bno)
                FROM tbl_board
                WHERE delflag = FALSE
                <include refid="search" />
        </select>

</mapper>
